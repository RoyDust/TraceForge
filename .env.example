# PostgreSQL — Prisma 迁移与 Rust sqlx 共用 (单一事实源)
DATABASE_URL="postgresql://traceforge:traceforge@localhost:5432/traceforge"

# Redis — 限流 / 并发 / API Key 缓存
REDIS_URL="redis://localhost:6379"

# Console 单管理员 (NextAuth Credentials)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""            # bcrypt / argon2 哈希, 不存明文

# Provider API Key 加密 (AES-256-GCM); 32 字节密钥, hex/base64
MASTER_ENCRYPTION_KEY=""
