# PostgreSQL — Prisma 迁移与 Rust sqlx 共用 (单一事实源)
DATABASE_URL="postgresql://traceforge:traceforge@localhost:5432/traceforge"

# 显式演示开关，不依赖 NODE_ENV。true 且未配置管理员时使用 demo@traceforge.local / traceforge-demo。
DEMO_MODE="false"

# Console 单管理员
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="" # 支持 plain:<password>、sha256:<hex> 或 raw sha256 hex

# Provider API Key 加密 (AES-256-GCM); 32 字节密钥, base64
MASTER_ENCRYPTION_KEY=""

# Chat Playground — Console 服务端代理调用 Gateway
TRACEFORGE_CHAT_GATEWAY_URL="http://localhost:8787"
TRACEFORGE_CHAT_API_KEY=""

TRACEFORGE_CHAT_TIMEOUT_MS="30000"
TRACEFORGE_EVAL_GATEWAY_URL="http://localhost:8787"
TRACEFORGE_EVAL_API_KEY=""
TRACEFORGE_EVAL_TIMEOUT_MS="30000"
TRACEFORGE_EVAL_MAX_CASES="20"
TRACEFORGE_EVAL_TOTAL_TIMEOUT_MS="120000"

# 仅显式 seed 使用的 mock 上游，不在运行时生成数据
TRACEFORGE_DEMO_UPSTREAM_URL="http://localhost:8799/v1"
