# Copy to a private absolute path; replace every CHANGE_ME before deployment.
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_PASSWORD
DATABASE_URL=postgresql://traceforge:CHANGE_ME_URL_SAFE_RANDOM_PASSWORD@postgres:5432/traceforge
MASTER_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=sha256:CHANGE_ME_SHA256_OF_A_LONG_RANDOM_PASSWORD
TRACEFORGE_PROJECT_ID=CHANGE_ME_UUID
TRACEFORGE_PROJECT_NAME=Production
TRACEFORGE_CHAT_API_KEY=CHANGE_ME_RANDOM_PROJECT_KEY_AT_LEAST_24_CHARACTERS
TRACEFORGE_EVAL_API_KEY=CHANGE_ME_RANDOM_PROJECT_KEY_AT_LEAST_24_CHARACTERS
TRACEFORGE_CHAT_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=https://CHANGE_ME_RELAY_HOST/v1
# Only needed during provider initialization; remove afterwards.
DEEPSEEK_API_KEY=CHANGE_ME_UPSTREAM_KEY
NGINX_CONFIG_PATH=/absolute/path/to/traceforge.conf
TLS_CERT_DIR=/absolute/path/to/certificates
